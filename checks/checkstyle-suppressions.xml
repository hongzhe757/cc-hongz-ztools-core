<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- PasswdStrength: PASSWD_LEVEL 和 CHAR_TYPE 枚举名含下划线，与算法库原名保持一致 -->
    <suppress files="PasswdStrength.java" checks="TypeName"/>

    <!-- PasswdStrength: check/getLevel/checkCharacterType 方法中的魔数是密码强度算法固有常量 -->
    <suppress files="PasswdStrength.java" checks="MagicNumber"/>

    <!-- PasswdStrength: CHAR_TYPE 枚举常量名称自解释，无需 Javadoc -->
    <suppress files="PasswdStrength.java" checks="JavadocVariable"/>

    <!-- UUID: Hutool 原版逐字拷贝，不做 checkstyle 清理 -->
    <suppress files="UUID.java" checks=".*"/>
</suppressions>
