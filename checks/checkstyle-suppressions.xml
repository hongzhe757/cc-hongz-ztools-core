<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- IdcardUtil 移植自 hutool，静态数据初始化和算法常量不提取 -->
    <suppress checks="MagicNumber" files="IdcardUtil\.java"/>
    <!-- HexUtil javadoc 含<br>和嵌套括号，中文句号检测误报 -->
    <suppress checks="JavadocStyle" files="HexUtil\.java"/>
    <!-- HashUtil javadoc 含中文句号和字段级javadoc，检测误报 -->
    <suppress checks="JavadocStyle" files="HashUtil\.java"/>
    <!-- HashUtil zobrist/murmur 算法位掩码和索引偏移 -->
    <suppress checks="MagicNumber" files="HashUtil\.java" lines="286-660"/>
</suppressions>
